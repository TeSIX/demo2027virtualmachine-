# Настройки стенда DEMO2027. Скопируйте в config.env и поправьте под вашу площадку:
#   cp config.env.example config.env
# config.env НЕ коммитится в git (см. .gitignore) — там пароли.

# Имена сетевых адаптеров. Обычно НЕ трогать: скрипты сами определяют 1-й, 2-й и 3-й
# физический интерфейс (материал называет их ens33/ens37/ens38, но гипервизор может
# дать, например, ens34 вместо ens37 — как на BR-RTR из стенда). Заполняйте, только
# если автоопределение выбрало не тот порядок адаптеров:
#IFACE1="ens33"
#IFACE2="ens37"
#IFACE3="ens38"

DOMAIN="au-team.irpo"
TIMEZONE="Asia/Irkutsk"          # часовой пояс площадки

# Пароли учебного стенда (в материале: P@ssw0rd). Для реального стенда замените!
SSHUSER_PASSWORD="P@ssw0rd"      # sshuser на HQ-SRV / BR-SRV / HQ-CLI
NET_ADMIN_PASSWORD="P@ssw0rd"    # net_admin на HQ-RTR / BR-RTR
DOMAIN_USER_PASSWORD="P@ssw0rd"  # hquser1..hquser5 в Samba DC
WEB_HTPASSWD_PASSWORD="P@ssw0rd" # пользователь WEB для reverse proxy (модуль 3)
IRPOADMIN_PASSWORD="P@ssw0rd"    # irpoadmin на HQ-CLI (доступ к репозиторию бэкапа)

# Пароль администратора домена для ввода HQ-CLI в домен (модуль 2). Пусто = шаг пропускается.
DOMAIN_ADMIN_PASSWORD=""

# MAC-адрес HQ-CLI (узнать на HQ-CLI: ip link show ens33). Нужен для DHCP-резерва 192.168.200.2.
HQ_CLI_MAC="52:54:00:12:34:56"

# RAID 0 на HQ-SRV (модуль 2): ДВА ДОПОЛНИТЕЛЬНЫХ ПУСТЫХ диска. Системный диск указывать НЕЛЬЗЯ!
RAID_DISKS="/dev/sdb /dev/sdc"
RAID_CONFIRM=""                  # для создания RAID выставьте RAID_CONFIRM=YES

# Парольная фраза шифрования репозитория restic irpo (модуль 3). Пусто = init пропускается.
RESTIC_REPO_PASSWORD=""

# Куда клонирует install.sh
INSTALL_DIR="/opt/demo2027"
REPO_URL="https://github.com/TeSIX/demo2027virtualmachine-.git"
REPO_BRANCH="main"
